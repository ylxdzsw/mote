[Unit]
Description=Mote cloud documents and AI supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The supervisor may be root only so it can chown task-local writable paths and
# launch a transient worker. The worker itself is always the non-root mote-ai user.
User=root
Group=http
UMask=0007
Environment=MOTED_SOCKET=/run/moted/moted.sock
Environment=MOTED_DATA_DIR=/var/lib/mote
Environment=MOTED_STATE_DIR=/var/lib/mote-ai
Environment=MOTED_BACKUP_DIR=/var/backups/mote
Environment=MOTED_SOURCE_PATH=/root/mote
Environment=MOTED_SHARED_MU_DIR=/root/.mu
Environment=MOTED_MU_ENV_SOURCE=/root/.mu/.env
Environment=MOTED_WORKER_USER=mote-ai
Environment=MOTED_CONCURRENCY=2
Environment=MOTED_TASK_TIMEOUT_MS=900000
Environment=MOTED_MEMORY_MAX=2G
Environment=MOTED_CPU_QUOTA=200%
Environment=MOTED_TASKS_MAX=256
Environment=MOTED_MU_DEFAULT_MODEL=codex/gpt-5.6-luna
RuntimeDirectory=moted
RuntimeDirectoryMode=0755
StateDirectory=mote mote-ai
StateDirectoryMode=0700
ExecStart=/usr/bin/node --experimental-sqlite /root/mote/server/moted.mjs
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

# This is an example only; it does not provision users, install software, or
# activate the unit. The operator must provide /usr/bin/node, mu, systemd-run,
# /usr/bin/chromium, a non-root mote-ai account, and existing Mu credentials.
# Static Mote files remain under /var/www/mote; server code stays in /root/mote.
# Do not run the worker as root or grant SYS_ADMIN.
# Node 22.12 needs --experimental-sqlite; the flag is also accepted by newer Node.
# SQLite/WAL and backups are private and InaccessiblePaths in every worker.
# Workers see only their own task bind mount inside an otherwise empty tasks dir.
# Task candidates and Mu sessions persist until explicit task deletion (no TTL).
# Gate /api/documents, /api/settings, /api/indexing and /api/ai through the authenticated Unix-socket
# Nginx boundary. Public routes: GET /api/shared/:token and narrowly scoped
# /api/agent/:token[/resource] (access_log off). No direct TCP in production.
# Builtin workers get a task-only HTTP Unix socket, never the private API socket.
# Configure client_max_body_size 128m and no-store for API responses at the proxy.
# Backups are manual only; do not schedule them or publish data/backups.
